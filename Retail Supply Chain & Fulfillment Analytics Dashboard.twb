        <zone forceUpdate='true' h='4375' id='6' type-v2='text' w='100000' x='0' y='9375'>
          <formatted-text>
            <run fontalignment='1' fontname='Arial' fontsize='16'>End-to-End Supply Chain Performance Monitoring &amp; Operational Insights</run>
          </formatted-text>
        </zone>
        <zone h='27500' id='7' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='85000' x='7500' y='18750'>
          <zone forceUpdate='true' h='27250' id='10' type-v2='text' w='42417' x='7583' y='18875'>
            <formatted-text>
              <run bold='true' fontcolor='#00397f' fontname='Arial' fontsize='15'>Project Objective:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>To analyze retail supply chain performance </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>across sales, fulfillment, products, customers, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>and operations, enabling stakeholders to identify </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>revenue drivers, delivery risks, and operational </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>improvement opportunities.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#d9d9d9' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
              <format attr='padding-left' value='140' />
              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='27250' id='9' type-v2='text' w='42417' x='50000' y='18875'>
            <formatted-text>
              <run bold='true' fontcolor='#00397f' fontname='Arial' fontsize='15'>Key Business Questions:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>     How efficiently is the supply chain operating?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>     Where are delivery delays occurring?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>     Which products and categories drive performance?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>     Which customers and markets generate value?</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Arial' fontsize='11'>     What operational bottlenecks require attention?</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#d9d9d9' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
              <format attr='padding-left' value='50' />
              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#d9d9d9' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
