    <worksheet name='Operations - Delivery Risk Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#323232' fontname='Arial' fontsize='13'>Delivery Risk Heatmap</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_supply_chain_clean (Retail_suppy_chain)' name='federated.1xczqoh1ojz08i1cv5nze1yvi5hh' />
          </datasources>
          <datasource-dependencies datasource='federated.1xczqoh1ojz08i1cv5nze1yvi5hh'>
            <column caption='Late Delivery %' datatype='real' default-format='p0.00%' name='[On-Time Delivery % (copy)_3516109094666241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([late_delivery_risk])' />
            </column>
            <column caption='Category Name' datatype='string' name='[category_name]' role='dimension' type='nominal' />
