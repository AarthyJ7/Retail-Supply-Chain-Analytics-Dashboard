                  <formatted-text>
                    <run bold='true' fontcolor='#00397f' fontname='Arial' fontsize='15'>Project Objective:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='11'>To analyze retail supply chain performance </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='11'>across sales, fulfillment, products, customers, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='11'>and operations, enabling stakeholders to identify </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='11'>revenue drivers, delivery risks, and operational </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='11'>improvement opportunities.</run>
                  </formatted-text>
